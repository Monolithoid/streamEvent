# First publish to Docker Hub with GitHub Actions (optional DOCKERHUB_IMAGE variable).
# Use the same namespace/repository here, with a release or immutable sha tag.
RELAY_IMAGE=monolithoid/streamevent-relay:main
PUBLISH_USER=phone
# Use different long alphanumeric passwords (e.g. openssl rand -hex 24).
PUBLISH_PASSWORD=replace-with-a-long-random-password
READ_USER=relay
READ_PASSWORD=replace-with-a-different-long-password
YOUTUBE_RTMPS_URL=rtmps://a.rtmps.youtube.com:443/live2
YOUTUBE_STREAM_KEY=replace-with-your-youtube-key
RTMP_BIND_IP=0.0.0.0
RTMP_PORT=1935
WIDTH=1920
HEIGHT=1080
FPS=30
VIDEO_BITRATE=6000k
ENCODER_PRESET=veryfast
ENCODER_THREADS=4
RELAY_CPUS=5.0
# Local development: use the tracked file. In Coolify use the persistent VPS file.
MEDIAMTX_CONFIG=./config/mediamtx.yml
ASSETS_DIR=./assets
WAITING_IMAGE=/assets/waiting.png
OVERLAY_IMAGE=/assets/overlay.png
STALE_SECONDS=1.5
READY_FRAMES=5
OUTPUT_STALL_SECONDS=20

# Optional standalone docker-compose.rtmps.yml (see docs/rtmps.md).
# Generate with openssl rand -hex 32; use a different key from YouTube.
INGEST_STREAM_KEY=replace-with-a-random-64-character-hexadecimal-key
# Directory must already contain fullchain.pem and privkey.pem on the VPS.
RTMPS_CERTS_DIR=/opt/basket-live/certs
RTMPS_BIND_IP=0.0.0.0
RTMPS_PORT=1936

# Private overlay console, served behind an HTTPS reverse proxy (Coolify).
WEB_BIND_IP=127.0.0.1
WEB_PORT=8080
# Shared with RTMP/RTMPS ingest; see docs/web-console.md.
WEB_PUBLIC_URL=https://ingest.monolithoid.com
# Generate with: openssl rand -hex 32
WEB_SECRET_KEY=
# OAuth redirect URI: https://ingest.monolithoid.com/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated explicit allowlist; empty = nobody can access the console.
GOOGLE_ALLOWED_EMAILS=
